   --aob serum item+25 hex+4E2 40 hex 7D0
   aobMedicRaw = aobItem[0]--.."4E2"
   medicOffset = 50*40--0x7D0
   aobMedic = tonumber(aobMedicRaw, 16) + medicOffset
   baseItem = aobItem[0]
   baseMedic = string.sub(string.format("0x%X",aobMedic),3,15)
   aobItem.destroy()
end
